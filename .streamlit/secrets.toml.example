# Template only. Copy to .streamlit/secrets.toml for local runs, or paste the
# [snowflake] block into Streamlit Community Cloud's secrets manager.
# The real secrets.toml is gitignored and must never be committed.
#
# Key-pair auth is required: Snowflake has deprecated single-factor password
# auth for programmatic access. Generate a key with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
# then register the public key on the service user (see sql/05_...).

[snowflake]
account = "myorg-myaccount"
user = "ROUNDNESS_APP_SVC"
role = "ROUNDNESS_APP_ROLE"
warehouse = "ROUNDNESS_WH"
database = "ROUNDNESS_LAB"
schema = "APP"

# Paste the full PEM contents of rsa_key.p8, including the BEGIN/END lines.
private_key = """
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""

# Only set this if the key was generated with a passphrase.
# private_key_passphrase = ""

# Fallback only, if key-pair auth proves awkward: a programmatic access token.
# app/db.py uses private_key when present and falls back to this.
# pat = ""
